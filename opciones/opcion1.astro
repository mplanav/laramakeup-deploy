---
const {
  title = "",
  subtitle = "",
  workReelTitle = "",
  videoUrl = "#",
  introParagraphs = [],
  email = "",
  ctaText = "",
  ctaLink = "#"
} = Astro.props;
---

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  :root {
    --navbar-height: 4rem; /* Altura estimada del navbar (64px) */
  }

  section#home {
    min-height: calc(100vh - var(--navbar-height));
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: linear-gradient(to bottom, #0a0a0a, #1a1a1a);
    color: #fff;
    padding: calc(var(--navbar-height) + 1rem) 1.5rem 3rem;
    box-sizing: border-box;
  }

  h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: 1px;
    color: #ffffff;
    margin: 0;
  }

  p.subtitle {
    margin-top: 1rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.125rem;
    color: #b3b3b3;
  }

  .work-reel {
    margin-top: 3rem;
  }

  .work-reel h2 {
    font-family: 'Playfair Display', serif;
    font-weight: 500;
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .work-reel a {
    display: inline-block;
    background-color: #6b21a8;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    padding: 0.9rem 2rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.3s ease;
  }

  .work-reel a:hover {
    background-color: #a855f7;
  }

  .intro {
    margin-top: 4rem;
    max-width: 40rem;
    font-family: 'Poppins', sans-serif;
    color: #d1d1d1;
    line-height: 1.7;
  }

  .intro p {
    margin-bottom: 1rem;
  }

  .intro p.email {
    font-weight: 600;
    color: #ffffff;
  }

  a.cta {
    margin-top: 3rem;
    display: inline-block;
    background-color: #6b21a8;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    padding: 0.9rem 2.5rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  a.cta:hover {
    background-color: #a855f7;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2.2rem;
    }
    p.subtitle {
      font-size: 1rem;
    }
    .work-reel h2 {
      font-size: 1.5rem;
    }
  }
</style>

<section id="home">
  <h1>{title}</h1>
  <p class="subtitle">{subtitle}</p>

  <div class="work-reel">
    <h2>{workReelTitle}</h2>
    <a href={videoUrl} target="_blank" rel="noopener noreferrer">Play Video</a>
  </div>

  <div class="intro">
    {introParagraphs.map((text) => (
      <p set:html={text}></p>
    ))}
    <p class="email">{email}</p>
  </div>

  <a href={ctaLink} class="cta">{ctaText}</a>
</section>
