---
const {
  title = "",
  subtitle = "",
  workReelTitle = "",
  videoUrl = "#",
  introParagraphs = [],
  email = "",
  ctaText = "",
  ctaLink = "#"
} = Astro.props;
---

<!-- Importar fuentes -->
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  :root {
    --navbar-height: 4rem; /* Altura del navbar */
    --color-bg-top: #0b0b0d;
    --color-bg-bottom: #1a0f1e;
    --color-accent: #8b5cf6;
    --color-accent-hover: #a78bfa;
  }

  section#home {
    min-height: calc(100vh - var(--navbar-height));
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: radial-gradient(circle at 50% 20%, var(--color-bg-bottom), var(--color-bg-top) 70%);
    color: #fff;
    padding: calc(var(--navbar-height) + 1rem) 1.5rem 3rem;
    overflow: hidden;
    position: relative;
  }

  /* Fade-in animation */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  h1 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: 0.5px;
    margin: 0;
    color: #ffffff;
    animation: fadeIn 1s ease-out both;
  }

  p.subtitle {
    margin-top: 1rem;
    font-family: 'Manrope', sans-serif;
    font-size: 1.125rem;
    color: #c0c0c0;
    animation: fadeIn 1.2s ease-out both;
  }

  .work-reel {
    margin-top: 3rem;
    animation: fadeIn 1.4s ease-out both;
  }

  .work-reel h2 {
    font-family: 'Fraunces', serif;
    font-weight: 500;
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .work-reel a {
    display: inline-block;
    background-color: var(--color-accent);
    color: #111;
    font-family: 'Manrope', sans-serif;
    font-weight: 600;
    padding: 0.9rem 2rem;
    border-radius: 999px;
    text-decoration: none;
    letter-spacing: 0.5px;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .work-reel a:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .intro {
    margin-top: 4rem;
    max-width: 40rem;
    font-family: 'Manrope', sans-serif;
    color: #d6d6d6;
    line-height: 1.7;
    animation: fadeIn 1.6s ease-out both;
  }

  .intro p {
    margin-bottom: 1rem;
  }

  .intro p.email {
    font-weight: 600;
    color: #ffffff;
  }

  a.cta {
    margin-top: 3rem;
    display: inline-block;
    background-color: var(--color-accent);
    color: #111;
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    padding: 0.9rem 2.5rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.3s ease, transform 0.2s ease;
    animation: fadeIn 1.8s ease-out both;
  }

  a.cta:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2.3rem;
    }
    p.subtitle {
      font-size: 1rem;
    }
    .work-reel h2 {
      font-size: 1.5rem;
    }
  }
</style>

<section id="home">
  <h1>{title}</h1>
  <p class="subtitle">{subtitle}</p>

  <div class="work-reel">
    <h2>{workReelTitle}</h2>
    <a href={videoUrl} target="_blank" rel="noopener noreferrer">Play Video</a>
  </div>

  <div class="intro">
    {introParagraphs.map((text) => (
      <p set:html={text}></p>
    ))}
    <p class="email">{email}</p>
  </div>

  <a href={ctaLink} class="cta">{ctaText}</a>
</section>
