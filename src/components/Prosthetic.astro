<section id="prosthetic" class="py-24 bg-neutral-950 text-white font-[Work_Sans]">
  <!-- Fuentes globales -->
  <link
    href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400;500;600&family=Work_Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  >

  <!-- Título principal -->
  <h2 class="text-4xl font-[Bodoni_Moda] font-medium text-center mb-16 tracking-wide">
    Prosthetic Works
  </h2>

  <!-- GALERÍA DE IMÁGENES -->
  <div class="max-w-3xl mx-auto relative bg-neutral-900 rounded-lg overflow-hidden mb-8 shadow-lg">
    <img
      id="prostheticImage"
      src=""
      alt="Prosthetic Makeup Work"
      class="w-full md:h-[500px] sm:h-[350px] h-[280px] object-contain mx-auto bg-neutral-900 transition-opacity duration-500 opacity-0"
    >

    <!-- Flechas -->
    <button
      id="prostheticPrev"
      class="absolute top-1/2 left-2 -translate-y-1/2 bg-black/40 text-white p-3 rounded-full hover:bg-purple-700 transition"
    >
      &#10094;
    </button>
    <button
      id="prostheticNext"
      class="absolute top-1/2 right-2 -translate-y-1/2 bg-black/40 text-white p-3 rounded-full hover:bg-purple-700 transition"
    >
      &#10095;
    </button>
  </div>

  <!-- Miniaturas -->
  <div id="prostheticThumbnails" class="max-w-3xl mx-auto flex justify-center gap-4 mt-6 overflow-hidden"></div>

  <!-- ESTILOS -->
  <style>
    @media (max-width: 768px) {
      #prostheticThumbnails {
        gap: 0.75rem;
        justify-content: center;
      }

      #prostheticThumbnails img {
        width: 80px;
        height: 80px;
      }
    }

    @media (max-width: 480px) {
      #prostheticThumbnails img {
        width: 70px;
        height: 70px;
      }
    }
  </style>

  <!-- SCRIPT -->
  <script>
    fetch("/api/prostheticworks_es.json")
      .then(res => res.json())
      .then(data => {
        const images = data.images || [];
        const videos = data.videos || [];

        // ---- IMÁGENES ----
        const prostheticImage = document.getElementById("prostheticImage");
        const prevBtn = document.getElementById("prostheticPrev");
        const nextBtn = document.getElementById("prostheticNext");
        const thumbsContainer = document.getElementById("prostheticThumbnails");

        let currentIndex = 0;
        let startThumb = 0;
        const visibleThumbs = 3;

        function renderThumbnails() {
          thumbsContainer.innerHTML = "";
          const endThumb = Math.min(startThumb + visibleThumbs, images.length);
          const visibleImages = images.slice(startThumb, endThumb);

          visibleImages.forEach((img, i) => {
            const realIndex = startThumb + i;
            const thumb = document.createElement("img");
            thumb.src = img;
            thumb.className =
              "prosthetic-thumb w-24 h-24 object-cover rounded-md cursor-pointer border-2 transition " +
              (realIndex === currentIndex ? "border-purple-700" : "border-transparent hover:border-purple-700");
            thumb.dataset.index = realIndex;
            thumbsContainer.appendChild(thumb);

            thumb.addEventListener("click", () => showImage(realIndex));
          });
        }

        function updateThumbnailsPosition() {
          if (currentIndex < startThumb) {
            startThumb = currentIndex;
          } else if (currentIndex >= startThumb + visibleThumbs) {
            startThumb = currentIndex - visibleThumbs + 1;
          }
          renderThumbnails();
        }

        function showImage(index) {
          prostheticImage.classList.remove("opacity-100");
          prostheticImage.classList.add("opacity-0");
          setTimeout(() => {
            currentIndex = index;
            prostheticImage.src = images[currentIndex];
            prostheticImage.classList.remove("opacity-0");
            prostheticImage.classList.add("opacity-100");
            updateThumbnailsPosition();
          }, 250);
        }

        prevBtn.addEventListener("click", () => {
          const newIndex = (currentIndex - 1 + images.length) % images.length;
          showImage(newIndex);
        });

        nextBtn.addEventListener("click", () => {
          const newIndex = (currentIndex + 1) % images.length;
          showImage(newIndex);
        });

        if (images.length > 0) {
          prostheticImage.src = images[0];
          prostheticImage.classList.add("opacity-100");
          renderThumbnails();
        }

        // ---- VIDEOS ----
        // (Prosthetic no tenía galería de vídeos activa en tu versión original.
        //  Si quieres reactivarla, te preparo la sección completa como en SFX y Mould.)
      })
      .catch((err) => console.error("Error cargando prosthetic:", err));
  </script>
</section>
