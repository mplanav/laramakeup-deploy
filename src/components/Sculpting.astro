<section id="sculpting" class="py-24 bg-neutral-950 text-white font-[Work_Sans]">
  <!-- Fuentes -->
  <link
    href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400;500;600&family=Work+Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  >

  <!-- Título -->
  <h2 class="text-4xl font-[Bodoni_Moda] font-medium text-center mb-16 tracking-wide">
    Sculpting Works
  </h2>

  <!-- GALERÍA DE IMÁGENES -->
  <div class="max-w-3xl mx-auto relative bg-neutral-900 rounded-lg overflow-hidden mb-8 shadow-lg">
    <img
      id="sculptImage"
      src=""
      alt="Sculpting Work"
      class="w-full md:h-[500px] sm:h-[350px] h-[280px] object-contain mx-auto bg-neutral-900 transition-opacity duration-500 opacity-0"
    >

    <!-- Flechas -->
    <button
      id="prevSculptBtn"
      class="absolute top-1/2 left-2 -translate-y-1/2 bg-black/40 text-white p-3 rounded-full hover:bg-purple-700 transition"
    >
      &#10094;
    </button>
    <button
      id="nextSculptBtn"
      class="absolute top-1/2 right-2 -translate-y-1/2 bg-black/40 text-white p-3 rounded-full hover:bg-purple-700 transition"
    >
      &#10095;
    </button>
  </div>

  <!-- Miniaturas -->
  <div id="sculptThumbnails" class="max-w-3xl mx-auto flex justify-center gap-4 mt-6 overflow-hidden"></div>

  <!-- GALERÍA DE VIDEOS -->
  <div class="mt-24">
    <h3 class="text-2xl font-[Bodoni_Moda] font-medium text-center mb-10 tracking-wide">
      Videos
    </h3>

    <div class="max-w-3xl mx-auto relative bg-neutral-900 rounded-lg overflow-hidden shadow-lg">
      <video
        id="sculptVideo"
        src=""
        controls
        class="w-full md:h-[500px] sm:h-[350px] h-[280px] object-contain mx-auto bg-neutral-900 transition-opacity duration-500 opacity-0"
      ></video>

      <button
        id="prevSculptVideoBtn"
        class="absolute top-1/2 left-2 -translate-y-1/2 bg-black/40 text-white p-3 rounded-full hover:bg-purple-700 transition"
      >
        &#10094;
      </button>
      <button
        id="nextSculptVideoBtn"
        class="absolute top-1/2 right-2 -translate-y-1/2 bg-black/40 text-white p-3 rounded-full hover:bg-purple-700 transition"
      >
        &#10095;
      </button>
    </div>

    <div
      id="sculptVideoThumbnails"
      class="max-w-3xl mx-auto flex justify-center gap-4 mt-6 flex-wrap"
    ></div>
  </div>

  <!-- ESTILOS -->
  <style>
    @media (max-width: 768px) {
      #sculptThumbnails {
        gap: 0.75rem;
        justify-content: center;
      }

      #sculptThumbnails img {
        width: 80px;
        height: 80px;
      }
    }

    @media (max-width: 480px) {
      #sculptThumbnails img {
        width: 70px;
        height: 70px;
      }
    }
  </style>

  <!-- SCRIPT -->
  <script>
    fetch("/api/sculpting_es.json")
      .then(res => res.json())
      .then(data => {
        // ---- IMÁGENES ----
        const images = data.images || [];
        const sculptImage = document.getElementById("sculptImage");
        const prevBtn = document.getElementById("prevSculptBtn");
        const nextBtn = document.getElementById("nextSculptBtn");
        const thumbsContainer = document.getElementById("sculptThumbnails");

        let currentIndex = 0;
        let startThumb = 0;
        const visibleThumbs = 3;

        function renderThumbnails() {
          thumbsContainer.innerHTML = "";
          const endThumb = Math.min(startThumb + visibleThumbs, images.length);
          const visibleImages = images.slice(startThumb, endThumb);

          visibleImages.forEach((img, i) => {
            const realIndex = startThumb + i;
            const thumb = document.createElement("img");
            thumb.src = img;
            thumb.className =
              "thumbnail w-24 h-24 object-cover rounded-md cursor-pointer border-2 transition " +
              (realIndex === currentIndex ? "border-purple-700" : "border-transparent hover:border-purple-700");
            thumb.dataset.index = realIndex;
            thumbsContainer.appendChild(thumb);

            thumb.addEventListener("click", () => showImage(realIndex));
          });
        }

        function updateThumbnailsPosition() {
          if (currentIndex < startThumb) {
            startThumb = currentIndex;
          } else if (currentIndex >= startThumb + visibleThumbs) {
            startThumb = currentIndex - visibleThumbs + 1;
          }
          renderThumbnails();
        }

        function showImage(index) {
          sculptImage.classList.remove("opacity-100");
          sculptImage.classList.add("opacity-0");
          setTimeout(() => {
            currentIndex = index;
            sculptImage.src = images[currentIndex];
            sculptImage.classList.remove("opacity-0");
            sculptImage.classList.add("opacity-100");
            updateThumbnailsPosition();
          }, 250);
        }

        prevBtn.addEventListener("click", () => {
          const newIndex = (currentIndex - 1 + images.length) % images.length;
          showImage(newIndex);
        });

        nextBtn.addEventListener("click", () => {
          const newIndex = (currentIndex + 1) % images.length;
          showImage(newIndex);
        });

        if (images.length > 0) {
          sculptImage.src = images[0];
          sculptImage.classList.add("opacity-100");
          renderThumbnails();
        }

        // ---- VIDEOS ----
        const videos = data.videos || [];
        const sculptVideo = document.getElementById("sculptVideo");
        const prevVideoBtn = document.getElementById("prevSculptVideoBtn");
        const nextVideoBtn = document.getElementById("nextSculptVideoBtn");
        const videoThumbsContainer = document.getElementById("sculptVideoThumbnails");

        let currentVideo = 0;

        videoThumbsContainer.innerHTML = videos
          .map(
            (vid, i) => `
            <video src="${vid}" muted preload="metadata"
              class="video-thumb w-28 h-20 object-cover rounded-md cursor-pointer border-2 ${
                i === 0 ? "border-purple-700" : "border-transparent"
              } hover:border-purple-700 transition"
              data-index="${i}">
            </video>
          `
          )
          .join("");

        const videoThumbs = document.querySelectorAll("#sculptVideoThumbnails .video-thumb");

        function updateActiveVideoThumb() {
          videoThumbs.forEach((thumb, i) => {
            thumb.classList.toggle("border-purple-700", i === currentVideo);
            thumb.classList.toggle("border-transparent", i !== currentVideo);
          });
        }

        function showVideo(index) {
          sculptVideo.classList.remove("opacity-100");
          sculptVideo.classList.add("opacity-0");
          setTimeout(() => {
            currentVideo = index;
            sculptVideo.src = videos[currentVideo];
            sculptVideo.load();
            sculptVideo.classList.remove("opacity-0");
            sculptVideo.classList.add("opacity-100");
            updateActiveVideoThumb();
          }, 250);
        }

        prevVideoBtn.addEventListener("click", () => {
          showVideo((currentVideo - 1 + videos.length) % videos.length);
        });

        nextVideoBtn.addEventListener("click", () => {
          showVideo((currentVideo + 1) % videos.length);
        });

        videoThumbs.forEach((thumb) => {
          thumb.addEventListener("click", () => {
            showVideo(parseInt(thumb.dataset.index));
          });
        });

        if (videos.length > 0) {
          sculptVideo.src = videos[0];
          sculptVideo.classList.add("opacity-100");
          updateActiveVideoThumb();
        }
      })
      .catch((err) => console.error("Error cargando sculpting:", err));
  </script>
</section>
